<p>
  <% if session[:login_uid] %>
    現在ログイン中のユーザID: <%= session[:login_uid] %> | 
    <%= link_to 'ログアウト', top_logout_path %>
  <% else %>
    <%= link_to 'ログイン画面へ', root_path %>
  <% end %>
</p>

<h1>ツイート一覧</h1>

<%# ログインしている時だけ新規ツイートのリンクを表示 %>
<% if session[:login_uid] %>
  <%= link_to '新規ツイート', new_tweet_path %> | 
<% end %>
<%= link_to 'ユーザ一覧へ', users_path %>

<hr>

<% @tweets.each do |tweet| %>
  <p>
    【ユーザID: <%= tweet.user.uid rescue tweet.user_id %>】 <%= tweet.message %> 
    <%= link_to '削除', tweet, data: { turbo_method: :delete } %>

    <%# ログインしている時だけ「いいね」リンクを表示 %>
    <% if session[:login_uid] %>
      <% if tweet.likes.find_by(user_id: User.find_by(uid: session[:login_uid])&.id) %>
        <%= link_to 'いいね削除', like_path(tweet), data: { turbo_method: :delete } %>
      <% else %>
        <%= link_to 'いいね', likes_path(tweet_id: tweet.id), data: { turbo_method: :post } %>
      <% end %>
    <% end %>
  </p>
<% end %>