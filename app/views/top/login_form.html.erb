<h1>ログイン</h1>

<%= form_with url: top_login_path, local: true do |f| %>
  <p>
    <%= f.label :uid, 'ユーザID' %><br>
    <%= f.text_field :uid %>
  </p>
  <p>
    <%= f.label :pass, 'パスワード' %><br>
    <%= f.password_field :pass %>
  </p>
  <p><%= f.submit 'ログイン' %></p>
<% end %>

<hr>
<%= link_to '新規ユーザ登録はこちら', new_user_path %>