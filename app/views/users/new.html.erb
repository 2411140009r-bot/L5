<h1>ユーザ登録</h1>

<%= form_with model: @user, local: true do |f| %>
  <p>
    <%= f.label :uid, 'ユーザーID' %>
    <%= f.text_field :uid %>
  </p>
  <p>
    <%= f.label :password, 'パスワード' %>
    <%= f.text_field :password %>
  </p>
  <p>
    <%= f.label :password_confirmation, 'パスワード（確認）' %>
    <%= f.text_field :password_confirmation %>
  </p>
  <%= f.submit '登録' %>
<% end %>

<%= link_to '一覧に戻る', users_path %>